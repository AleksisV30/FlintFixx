# Copy this file to .env and fill it in. Never commit .env.

# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=
# Discord Developer Portal -> your application -> General Information -> Application ID
DISCORD_CLIENT_ID=
# Your server's ID (Discord: Settings -> Advanced -> Developer Mode, then right-click the server -> Copy Server ID)
DISCORD_GUILD_ID=

# Channel where new GitHub releases are announced (right-click the channel -> Copy Channel ID). Optional.
ANNOUNCE_CHANNEL_ID=
# Channel where /report bug reports are posted for staff. Optional; without it reports go to the announce channel.
REPORTS_CHANNEL_ID=

# GitHub repository the client is released from.
GITHUB_REPO=AleksisV30/FlintFixx
# Optional GitHub token (no scopes needed for a public repo). Raises the API limit from 60 to 5000 requests an hour.
GITHUB_TOKEN=

# FlintFix social/chat backend that /status checks.
BACKEND_URL=http://135.181.218.53:50006

# Shown by /download when no GitHub release exists yet, and linked from embeds.
WEBSITE_URL=https://github.com/AleksisV30/FlintFixx/releases
